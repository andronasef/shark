---
import '../styles/global.css';
const base = import.meta.env.BASE_URL;
interface Props { title?: string; description?: string; }
const {
  title = 'Shark — Your files. More possibilities.',
  description = 'A free, native Mac file manager with tabs, split panes, a built-in terminal, and quick previews. Familiar on the outside. More capable within.',
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f9fc" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(`${base.replace(/\/$/, '')}/icon.png`, Astro.site).href} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/png" href={`${base.replace(/\/$/, '')}/icon.png`} />
    <link rel="canonical" href={Astro.url} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>

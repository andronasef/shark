---
---
<button
  type="button"
  id="theme-toggle"
  class="theme-toggle"
  aria-label="Toggle dark mode"
  title="Toggle dark mode"
>
  <svg class="theme-icon theme-icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <line x1="12" y1="1" x2="12" y2="3"></line>
    <line x1="12" y1="21" x2="12" y2="23"></line>
    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
    <line x1="1" y1="12" x2="3" y2="12"></line>
    <line x1="21" y1="12" x2="23" y2="12"></line>
    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
  </svg>
  <svg class="theme-icon theme-icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
</button>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 999px;
    background: transparent;
    border: 1px solid transparent;
    color: var(--secondary);
    cursor: pointer;
    padding: 0;
    flex-shrink: 0;
    order: 3;
    transition: background 0.2s cubic-bezier(0.16, 1, 0.3, 1), color 0.2s cubic-bezier(0.16, 1, 0.3, 1), transform 0.15s cubic-bezier(0.16, 1, 0.3, 1);
    -webkit-tap-highlight-color: transparent;
  }
  .theme-toggle:hover {
    background: rgba(24, 35, 46, 0.08);
    color: var(--ink);
  }
  :global(html.dark) .theme-toggle:hover,
  :global([data-theme="dark"]) .theme-toggle:hover {
    background: rgba(240, 246, 252, 0.1);
    color: var(--ink);
  }
  @media (prefers-color-scheme: dark) {
    :global(html:not([data-theme="light"])) .theme-toggle:hover {
      background: rgba(240, 246, 252, 0.1);
      color: var(--ink);
    }
  }
  .theme-toggle:active {
    transform: scale(0.92);
  }
  .theme-toggle:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .theme-icon {
    display: none;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  /* Default / Light: show moon icon */
  .theme-icon-moon {
    display: block;
  }
  .theme-icon-sun {
    display: none;
  }
  /* Dark mode: show sun icon */
  :global(html.dark) .theme-icon-moon,
  :global([data-theme="dark"]) .theme-icon-moon {
    display: none;
  }
  :global(html.dark) .theme-icon-sun,
  :global([data-theme="dark"]) .theme-icon-sun {
    display: block;
  }
  @media (prefers-color-scheme: dark) {
    :global(html:not([data-theme="light"])) .theme-icon-moon {
      display: none;
    }
    :global(html:not([data-theme="light"])) .theme-icon-sun {
      display: block;
    }
  }
</style>

<script>
  function setupThemeToggle() {
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;

    const getEffectiveTheme = (): 'dark' | 'light' => {
      const stored = localStorage.getItem('shark-theme');
      if (stored === 'dark' || stored === 'light') return stored;
      return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    };

    const updateLabel = (theme: 'dark' | 'light') => {
      const nextDesc = theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode';
      btn.setAttribute('aria-label', nextDesc);
      btn.setAttribute('title', nextDesc);
    };

    updateLabel(getEffectiveTheme());

    btn.addEventListener('click', () => {
      const current = getEffectiveTheme();
      const next = current === 'dark' ? 'light' : 'dark';
      localStorage.setItem('shark-theme', next);
      document.documentElement.setAttribute('data-theme', next);
      if (next === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
      updateLabel(next);
    });

    const mq = window.matchMedia('(prefers-color-scheme: dark)');
    mq.addEventListener('change', (e) => {
      if (!localStorage.getItem('shark-theme')) {
        const theme = e.matches ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', theme);
        document.documentElement.classList.toggle('dark', e.matches);
        updateLabel(theme);
      }
    });
  }

  setupThemeToggle();
  document.addEventListener('astro:after-swap', setupThemeToggle);
</script>

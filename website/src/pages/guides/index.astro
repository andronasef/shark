---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import Icon from '../../components/Icon.astro';
import '../../styles/guides.css';

const guides = (await getCollection('guides')).sort((a, b) => a.data.order - b.data.order);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Layout title="Mac file management guides — Shark" description="Practical guides for managing files on a Mac: Finder alternatives, File Explorer habits, side-by-side folders, cut and paste, and opening Terminal in a folder.">
  <SiteHeader currentPage="guides" />
  <main id="main">
    <section class="guide-hero container">
      <h1>Guides<br /><span>Get more out of your Mac’s files.</span></h1>
      <p>Short, practical answers to the questions people ask when Finder isn’t quite enough.</p>
    </section>
    <ul class="guide-grid container">
      {guides.map((g, i) => (
        <li class:list={['guide-card', { featured: i === 0 }]}>
          <a href={`${base}/guides/${g.id}/`}>
            {g.data.image && (
              <div class={`guide-card-image feature-image ${g.data.tint}`}>
                <Image
                  src={g.data.image}
                  alt={g.data.imageAlt ?? ''}
                  widths={i === 0 ? [640, 1000, 1400] : [480, 720, 960]}
                  sizes={i === 0 ? '(max-width: 800px) 90vw, 55vw' : '(max-width: 640px) 90vw, 45vw'}
                  loading={i === 0 ? 'eager' : 'lazy'}
                />
              </div>
            )}
            <div class="guide-card-copy">
              <h2>{g.data.title}</h2>
              <p>{g.data.description}</p>
              <span class="text-link">Read the guide <Icon name="arrow" size={16} /></span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </main>
  <SiteFooter />
</Layout>

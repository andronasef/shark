---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import DownloadLink from '../components/DownloadLink.astro';
import BrewCommand from '../components/BrewCommand.astro';
import MacAppStoreLink from '../components/MacAppStoreLink.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { featureGroups } from '../data/features';
import split from '../assets/tabs-and-split.webp';
import icon from '../assets/icon.png';
import terminal from '../assets/terminal.webp';
import folders from '../assets/subfolder-menu.webp';
import commandPalette from '../assets/command-palette.webp';
import cutPaste from '../assets/cut-paste.webp';

const faqs = [
  { q: "Is Shark free?", a: "Yes. Shark is free to download and use. You can also explore the source on <a href=\"https://github.com/andronasef/shark\">GitHub</a>." },
  { q: "Does Shark replace Finder?", a: "It can sit alongside Finder or take over. Shark opens folders in its own window, and Show in Finder is always one click away. Settings › General can ask macOS to make Shark your default folder app, or restore Finder. macOS does not always allow the change." },
  { q: "Will it work on my Mac?", a: "Shark requires macOS Sonoma 14 or later and supports Apple silicon and Intel Macs. Native Liquid Glass chrome is available on macOS 26; earlier versions use system materials." },
  { q: "How do I install it?", a: "Get it directly from the <a href=\"https://apps.apple.com/us/app/shark-file-manager/id6825086341\" target=\"_blank\" rel=\"noopener\">Mac App Store</a>. You can also download the latest Shark DMG, open it, and drag Shark.app to your Applications folder, or install with Homebrew: <code>brew install --cask andronasef/shark/shark</code>." },
  { q: "Why does it ask for folder access?", a: "macOS protects folders such as Documents and Downloads. Allow access to the folders you want to browse when macOS asks. You can manage those permissions in System Settings." },
  { q: "Can I use it with the keyboard?", a: "Yes. Open tabs with ⌘T, jump to a path with ⌘L, and open the command palette with ⌘K. F3 toggles split panes and F4 opens the terminal. Depending on your keyboard settings, hold Fn with the function keys." },
];
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') } })),
};
const totalFeatures = featureGroups.reduce((acc, g) => acc + g.features.length, 0);
const features = [
  {
    id: 'folders',
    icon: 'folder' as const,
    title: 'Jump anywhere in the\nfolder tree.',
    description: 'Hover over any path segment or folder to open a cascading menu. Browse nested contents, drill directly into deep directories, or open any subfolder in a new tab—without losing your place.',
    action: 'Your next folder is within reach.',
    shortcut: '⌘L',
    shortcutLabel: 'Go to a path',
    image: folders,
    alt: 'Shark showing cascading subfolder menus to jump directly into nested folders',
    tint: 'lavender',
  },
  {
    id: 'command-palette',
    icon: 'command' as const,
    title: 'Every action,\none keystroke away.',
    description: 'Press ⌘K to search actions, jump to recent or frequent locations, restore saved tab groups, or navigate directly to any path—all without taking your hands off the keyboard.',
    action: 'Never dig through menus again.',
    shortcut: '⌘K',
    shortcutLabel: 'Command palette',
    image: commandPalette,
    alt: 'The Shark command palette open, showing instant action search, recent folders, and paths',
    tint: 'blue',
  },
  {
    id: 'cut-paste',
    icon: 'scissors' as const,
    title: 'Cut and paste,\nfinally.',
    description: 'Move files the way you always expected. Press ⌘X to cut and ⌘V to paste. Items stay visually dimmed while queued, moves never overwrite by accident, and every action is fully undoable with ⌘Z.',
    action: 'Moving files just makes sense.',
    shortcut: '⌘X / ⌘V',
    shortcutLabel: 'Cut and paste',
    image: cutPaste,
    alt: 'Shark showing dimmed cut files ready to paste, with safe move and full Undo support',
    tint: 'peach',
  },
  {
    id: 'split',
    icon: 'split' as const,
    title: 'Two folders.\nOne window.',
    description: 'Keep your project folders in tabs, or press F3 to split the window into two panes side by side. Drag files directly across, pin favorites, and resume right where you left off.',
    action: 'A little more room. A lot less back and forth.',
    shortcut: 'F3',
    shortcutLabel: 'Split panes',
    image: split,
    alt: 'Shark with pinned folder tabs and two file panes side by side',
    tint: 'blue',
  },
  {
    id: 'terminal',
    icon: 'terminal' as const,
    title: 'A terminal right\nunder your files.',
    description: 'Your files above, a real interactive shell below. Browse to a repository and hit F4 to open a terminal in that exact directory—persistent across tabs, with full PTY support.',
    action: 'Less switching. More doing.',
    shortcut: 'F4',
    shortcutLabel: 'Terminal',
    image: terminal,
    alt: 'The built-in terminal open below Shark’s file browser',
    tint: 'mint',
  },
];
const tools = [
  ['Four ways to see your files', 'Icons, list, columns, or gallery. Choose the view that fits what you’re doing.'],
  ['Quick previews on hover', 'Peek inside images, documents, and code without opening another app, or press Space for Quick Look.'],
  ['The details, on hand', 'Check sizes, permissions, metadata, and SHA-256 checksums in the inspector.'],
  ['Thoughtful file operations', 'Batch rename with live preview, duplicate, archive, and calculated folder sizes in the status bar.'],
];
---
<Layout jsonLd={faqJsonLd}>
  <SiteHeader />

  <main id="main">
    <section class="hero" aria-labelledby="hero-heading">
      <div class="hero-copy container">
        <h1 id="hero-heading">Your files.<br /><span>More possibilities.</span></h1>
        <p class="hero-description">Cascading folders, a command palette, cut & paste, split panes, and a built-in terminal.<br class="desktop-break" /> All in a familiar Mac interface.</p>
        <div class="hero-actions"><MacAppStoreLink /><DownloadLink /><BrewCommand /><a class="text-link" href="#features">Meet Shark <Icon name="arrow" size={17} /></a></div>
        <p class="compatibility">Free. Made for Mac. <span>macOS 14 or later.</span></p>
      </div>
      <div class="hero-stage">
        <div class="hero-window">
          <Image src={split} alt="Shark file manager showing folder tabs, a familiar sidebar, and two panes for working between folders" widths={[780, 1200, 1800, 2400]} sizes="(max-width: 700px) 94vw, 86vw" loading="eager" fetchpriority="high" class="app-screenshot" />
        </div>
        <div class="feature-dock glass" aria-label="Explore Shark features">
          <a href="#folders"><Icon name="folder" /><span>Subfolders</span></a>
          <span class="dock-divider" aria-hidden="true"></span>
          <a href="#command-palette"><Icon name="command" /><span>Command palette</span><kbd>⌘K</kbd></a>
          <span class="dock-divider" aria-hidden="true"></span>
          <a href="#cut-paste"><Icon name="scissors" /><span>Cut & paste</span><kbd>⌘X</kbd></a>
          <span class="dock-divider" aria-hidden="true"></span>
          <a href="#split"><Icon name="split" /><span>Split panes</span><kbd>F3</kbd></a>
          <span class="dock-divider" aria-hidden="true"></span>
          <a href="#terminal"><Icon name="terminal" /><span>Terminal</span><kbd>F4</kbd></a>
        </div>
      </div>
      <p class="hero-caption">Feels like your Mac. Works the way you do.</p>
    </section>

    <section id="features" class="features container" aria-labelledby="features-heading">
      <div class="section-intro"><h2 id="features-heading">Familiar, with a few<br />very useful extras.</h2><p>For the folders you visit every day.<br />And everything you do between them.</p></div>
      {features.map((feature, index) => (
        <article id={feature.id} class:list={['feature-story', { reverse: index % 2 === 1 }]}>
          <div class="feature-copy">
            <div class:list={['feature-symbol', feature.tint]}><Icon name={feature.icon} size={25} /></div>
            <h3>{feature.title.split('\n').map((line, i) => <>{i > 0 && <> <br /></>}{line}</>)}</h3>
            <p>{feature.description}</p>
            <p class="feature-payoff">{feature.action}</p>
            <div class="shortcut"><kbd>{feature.shortcut}</kbd><span>{feature.shortcutLabel}</span></div>
          </div>
          <div class:list={['feature-image', feature.tint]}>
            <Image src={feature.image} alt={feature.alt} widths={[640, 1000, 1440]} sizes="(max-width: 800px) 90vw, 55vw" loading="lazy" />
          </div>
        </article>
      ))}
      <div class="all-features-link"><a class="text-link" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/features/`}>Explore all {totalFeatures} features <Icon name="arrow" size={17} /></a></div>
    </section>

    <section class="everyday" aria-labelledby="everyday-heading">
      <div class="container everyday-inner">
        <div class="everyday-heading"><h2 id="everyday-heading">The small things.<br />All thought through.</h2><p>A few more reasons to make yourself at home.</p></div>
        <dl class="tool-list">{tools.map(([title, description]) => <div><dt><Icon name="check" size={18} />{title}</dt><dd>{description}</dd></div>)}</dl>
      </div>
    </section>

    <section id="faq" class="faq container" aria-labelledby="faq-heading">
      <div><h2 id="faq-heading">A few things<br />you might ask.</h2><a class="text-link" href="https://userhq.increasinglabs.com/increasing-labs/shark">Have another question? <Icon name="arrow" size={17} /></a></div>
      <div class="faq-list">
        {faqs.map(f => <details><summary>{f.q}<span aria-hidden="true">+</span></summary><p set:html={f.a} /></details>)}
      </div>
    </section>

    <section class="closing container" aria-labelledby="closing-heading">
      <Image src={icon} alt="" width={92} height={92} layout="fixed" />
      <h2 id="closing-heading">Make room for<br />a better workflow.</h2>
      <p>Your next favorite place for your files.</p>
      <div class="cta-row"><MacAppStoreLink /><DownloadLink /><BrewCommand /></div>
      <p class="compatibility">Free · macOS 14+ · Apple silicon &amp; Intel</p>
    </section>
  </main>

  <SiteFooter />
</Layout>

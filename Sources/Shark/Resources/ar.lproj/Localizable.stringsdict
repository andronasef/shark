<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>items.count</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@items@</string>
		<key>items</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>zero</key>
			<string>%d عناصر</string>
			<key>one</key>
			<string>%d عنصر</string>
			<key>two</key>
			<string>%d عنصران</string>
			<key>few</key>
			<string>%d عناصر</string>
			<key>many</key>
			<string>%d عنصرًا</string>
			<key>other</key>
			<string>%d عنصر</string>
		</dict>
	</dict>
	<key>results.count</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>zero</key>
			<string>%d نتائج</string>
			<key>one</key>
			<string>%d نتيجة</string>
			<key>two</key>
			<string>%d نتيجتان</string>
			<key>few</key>
			<string>%d نتائج</string>
			<key>many</key>
			<string>%d نتيجةً</string>
			<key>other</key>
			<string>%d نتيجة</string>
		</dict>
	</dict>
	<key>tabs.count</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>zero</key>
			<string>%d علامات تبويب</string>
			<key>one</key>
			<string>%d علامة تبويب</string>
			<key>two</key>
			<string>%d علامتا تبويب</string>
			<key>few</key>
			<string>%d علامات تبويب</string>
			<key>many</key>
			<string>%d علامة تبويب</string>
			<key>other</key>
			<string>%d علامة تبويب</string>
		</dict>
	</dict>
</dict>
</plist>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Hardened Runtime for Developer ID direct distribution. No exceptions: the release build
         needs no JIT, unsigned executable memory, or unsigned libraries (Inject is debug-only). -->
    <!-- Empty Trash asks Finder to do it (Apple Events). Without this the Automation prompt never appears. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>

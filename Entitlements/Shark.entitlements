<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Core App Sandbox -->
    <key>com.apple.security.app-sandbox</key>
    <true/>

    <!-- User-selected file access for browsing, editing, and moving files -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>

    <!-- App-scoped bookmarks for persisting user-granted folder access across launches -->
    <key>com.apple.security.files.bookmarks.app-scope</key>
    <true/>

    <!-- Outgoing network client for remote disk mounts and network shares -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- Child process sandbox inheritance -->
    <key>com.apple.security.inherit</key>
    <true/>
</dict>
</plist>

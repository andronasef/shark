<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Application Identifier and Developer Team Identifier (required for TestFlight & App Store) -->
    <key>com.apple.application-identifier</key>
    <string>N4Z388PVQT.com.increasinglabs.shark</string>
    <key>com.apple.developer.team-identifier</key>
    <string>N4Z388PVQT</string>

    <!-- Core App Sandbox -->
    <key>com.apple.security.app-sandbox</key>
    <true/>

    <!-- User-selected file access for browsing, editing, and moving files -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>

    <!-- App-scoped bookmarks for persisting user-granted folder access across launches -->
    <key>com.apple.security.files.bookmarks.app-scope</key>
    <true/>

    <!-- Outgoing network client for remote disk mounts and network shares -->
    <key>com.apple.security.network.client</key>
    <true/>
</dict>
</plist>
